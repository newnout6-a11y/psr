# === LLM ===
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_BASE_URL=https://api.byesu.com
OPENAI_API_PREFIX=/v1
OPENAI_WIRE_API=responses
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=high
OPENAI_DISABLE_RESPONSE_STORAGE=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_PREFIX=
DEEPSEEK_WIRE_API=chat
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_THINKING=disabled
GROQ_API_KEY=your_groq_key_here
LLM_PROVIDER=openai
AI_SCORE_THRESHOLD=6
AI_SCORE_MODE=fast_full
AI_SCORE_BATCH_SIZE=20
AI_SCORE_DEEPSEEK_BATCH_SIZE=6
AI_SCORE_MAX_CANDIDATES=300
PARSER_LLM_PROVIDER=deepseek
PARSER_LLM_MODEL=deepseek-v4-flash
QUERY_GENERATION_PROVIDER=deepseek
DEEPSEEK_MODEL_QUERY_GENERATION=deepseek-v4-pro
SCORING_PROVIDER=deepseek
DEEPSEEK_MODEL_SCORING=deepseek-v4-flash
PROPOSAL_WRITING_PROVIDER=openai
PROPOSAL_IMAGE_ENABLED=false
PROPOSAL_IMAGE_MODEL=gpt-image-1
PROPOSAL_IMAGE_MIN_AI_SCORE=8
PROPOSAL_IMAGE_MIN_VET_SCORE=70
KWORK_IMAGE_ATTACH_CONFIRMED=false
ATTACHMENT_CONTEXT_ENABLED=true
ATTACHMENT_MAX_FILES=3
ATTACHMENT_MAX_BYTES=2000000
ATTACHMENT_MAX_CHARS=5000

# === Платформы (через запятую) ===
PLATFORMS=kwork,freelance_ru,hh_ru
# Описание поиска своими словами — AI сгенерирует запросы для каждой биржи
SEARCH_BRIEF=мелкие заказы на автоматизацию, ботов, парсеры, скрипты, небольшие сайты. бюджет до 10к. не на постоянку, не крупные проекты
# Fallback если AI недоступен (через |)
SEARCH_QUERY=python|telegram бот|парсер|api
# Сколько AI-запросов генерировать на платформу за цикл
DISCOVERY_MODE=wide
QUERY_COUNT=8
# Сколько страниц парсить по каждому запросу
PAGES_TO_PARSE=50
MAX_PAGES_PER_QUERY=50
MAX_PROJECTS_PER_CYCLE=500
MAX_PARSE_SECONDS=90
# 0 = обрабатывать все vetted-кандидаты текущего цикла
TOP_PROJECTS=0

# --- Kwork Anti-Detection ---
# TLS-имитация: заменяет aiohttp на curl_cffi с browser fingerprint
KWORK_TLS_IMPERSONATE=true
KWORK_TLS_BROWSER=chrome120
# Rate pacing: human-like задержки между API вызовами
KWORK_PACING=true
KWORK_PACE_MIN=1.5
KWORK_PACE_MAX=4.0
KWORK_BURST_LIMIT=8
KWORK_BURST_WINDOW=60
# Proxy rotation: список residential прокси через запятую
# KWORK_PROXY_LIST=http://user:pass@proxy1:port,http://user:pass@proxy2:port
# Browser proxy: PROXY_URL используется и для API и для браузера
# Cloudflare: cf_verify() автоматически решает Turnstile challenge
# cf_clearance cookie персистится в browser profile
# Connects мониторинг
KWORK_CONNECTS_WARN=5
KWORK_CONNECTS_BLOCK=2
# Auto-approve назначенных заказов (auto-assignment trap)
KWORK_AUTO_APPROVE_ORDERS=false
# Fast inbox polling — проверка входящих каждые N секунд (независимо от цикла)
KWORK_FAST_INBOX_POLLING=true
KWORK_INBOX_POLL_INTERVAL=300
# Response time alert — предупреждение при непрочитанных сообщениях старше N часов
KWORK_RESPONSE_TIME_ALERT_HOURS=2
# Success rate monitoring — блокировка отправки при низком рейтинге
KWORK_SUCCESS_RATE_WARN=80
KWORK_SUCCESS_RATE_BLOCK=70
# Account health — auto-pause kworks when overloaded
KWORK_BUSY_THRESHOLD=5
KWORK_AUTO_PAUSE_KWORKS=false
# Auto-review after completed order
KWORK_AUTO_REVIEW=false
KWORK_AUTO_REVIEW_RATING=5
KWORK_AUTO_REVIEW_TEXT=Спасибо за заказ! Буду рад сотрудничеству в будущем.
# Telegram attachments — max files per project to send
TG_MAX_ATTACHMENTS=5

# === Session Hub (основной источник кук) ===
SESSION_HUB_URL=http://127.0.0.1:8669/cookies
# Строгий режим: если Hub недоступен — НЕ использовать .env, упасть с ошибкой.
# Рекомендуется для prod: куки в .env быстро протухают.
SESSION_HUB_REQUIRED=false

# === Kwork авторизация (fallback, если Session Hub недоступен) ===
KWORK_EMAIL=
KWORK_PASSWORD=
KWORK_JWT_TOKEN=
KWORK_COOKIE_REMEMBERME=
KWORK_COOKIE_USERID=
KWORK_COOKIE_PHPSESSID=
KWORK_COOKIE_CSRF=

# === Freelance.ru авторизация (fallback, если Session Hub недоступен) ===
FREELANCE_RU_COOKIES_JSON=
FREELANCE_RU_COOKIE_SESSION=
FREELANCE_RU_COOKIE_DUID=
FREELANCE_RU_COOKIE_REMEMBER=

# === Telegram бот ===
TELEGRAM_TOKEN=
ADMIN_CHAT_ID=
# auto = direct Bot API first, MTProto fallback if TELEGRAM_API_ID/HASH are set
TELEGRAM_TRANSPORT=auto
# Default direct route. Can point to a local telegram-bot-api server, e.g. http://127.0.0.1:8081
TELEGRAM_BOT_API_BASE=https://api.telegram.org
# Optional MTProto fallback, uses Telegram DCs instead of api.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_MTPROTO_SESSION=
APPROVAL_TIMEOUT=900
TELEGRAM_DIGEST_ENABLED=false
DIGEST_INTERVAL_MIN=60
TELEGRAM_QUEUE_PAGE_SIZE=5

# === Прокси ===
PROXY_URL=

# === Браузер ===
BROWSER_HEADLESS=true

# === Режим работы ===
CONTINUOUS_MODE=false
CYCLE_INTERVAL=1800
EXECUTION_MODE=semi_auto
AUTO_SEND_SCORE_MIN=8
AUTO_SEND_VET_MIN=60
AUTO_SEND_MAX_OFFERS=20
AUTO_SEND_MAX_BUDGET=10000

# === OSINT-обогащение заказчика ===
OSINT_ENABLED=false
# Публичные OSINT-провайдеры: github, habr, duckduckgo, kwork_profile
OSINT_PROVIDERS=github,habr,duckduckgo,kwork_profile
# GitHub token (опционально, поднимает лимит до 5000 req/h)
GITHUB_TOKEN=

# --- Пробив-площадки ---
# Бесплатные (emailrep, whatsmyname) работают из коробки, платные — только при наличии ключа
# Пусто = probiv отключён. Включай явно, если нужен глубокий медленный пробив.
OSINT_PROBIV_PROVIDERS=
# Full scan WhatsMyName по всем 600+ сайтам (по умолчанию только ~200 популярных)
OSINT_WMN_FULL=false

# EmailRep (бесплатно; ключ увеличивает лимит)
# Регистрация: https://emailrep.io/key
EMAILREP_KEY=

# Have I Been Pwned (~$3.50/мес)
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# LeakCheck.io (от $3/мес)
# https://leakcheck.io/api
LEAKCHECK_API_KEY=

# Intelligence X (free tier + paid)
# Получить ключ: https://intelx.io/account?tab=developer
INTELX_API_KEY=
# ВАЖНО: free-tier использует ОТДЕЛЬНЫЙ хост. По умолчанию стоит free:
#   free  → https://free.intelx.io
#   paid  → https://2.intelx.io
INTELX_BASE_URL=https://free.intelx.io
# Buckets через запятую (пусто = дефолт: leaks+darknet+pastes+dumpster+whois+usenet)
INTELX_BUCKETS=
# Кол-во результатов на запрос (25 достаточно для триажа, экономит время)
INTELX_MAX_RESULTS=25

# === Shodan (для Origin IP) ===
SHODAN_API_KEY=

# === Часовой пояс ===
TIMEZONE_REGION=Europe/Warsaw
