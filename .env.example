# API ключи
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Платформы (через запятую)
PLATFORMS=kwork,fl_ru,upwork

# Прокси (IPv6 ротация) — оставь пустым если vproxy не настроен
PROXY_URL=

# LLM провайдер (openai или anthropic)
LLM_PROVIDER=openai

# Часовой пояс
TIMEZONE_REGION=Europe/Warsaw

# Минимальный порог релевантности (0.0-1.0)
MIN_RELEVANCE_SCORE=0.75

# Непрерывный режим
CONTINUOUS_MODE=false
CYCLE_INTERVAL=3600

# Shodan API (для поиска Origin IP)
SHODAN_API_KEY=your_shodan_key_here
