{
  "name": "psr-desktop",
  "version": "1.0.0",
  "description": "PSR Desktop — freelance automation control center",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others \"vite\" \"wait-on tcp:localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "lucide-react": "^0.344.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.6.4",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "picomatch": "4.0.3"
  },
  "build": {
    "appId": "com.psr.desktop",
    "productName": "PSR Desktop",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "psr-backend/src"
      },
      {
        "from": "../config",
        "to": "psr-backend/config"
      },
      {
        "from": "../data/reference",
        "to": "psr-backend/data/reference"
      },
      {
        "from": "../requirements.txt",
        "to": "psr-backend/requirements.txt"
      },
      {
        "from": "../.env.example",
        "to": "psr-backend/.env.example",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    }
  }
}
