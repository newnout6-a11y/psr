# === LLM ===
GROQ_API_KEY=your_groq_key_here
GOOGLE_API_KEY=your_google_key_here
LLM_PROVIDER=groq
LLM_FALLBACK=google
AI_SCORE_THRESHOLD=6
QUERY_GENERATION_PROVIDER=auto
SCORING_PROVIDER=auto
PROPOSAL_WRITING_PROVIDER=auto

# === Phase 3 A/B на промпт (опционально) ===
# Формат: "<имя_варианта>:<temperature>,<имя_варианта>:<temperature>".
# Пусто (по умолчанию) — A/B выключен, используется дефолтная temperature=0.75.
# Пример: PROMPT_AB_VARIANTS=control:0.65,warm:0.85
PROMPT_AB_VARIANTS=

# === Платформы (через запятую) ===
PLATFORMS=kwork,freelance_ru,hh_ru
# Описание поиска своими словами — AI сгенерирует запросы для каждой биржи
SEARCH_BRIEF=мелкие заказы на автоматизацию, ботов, парсеры, скрипты, небольшие сайты. бюджет до 10к. не на постоянку, не крупные проекты
# Fallback если AI недоступен (через |)
SEARCH_QUERY=python|telegram бот|парсер|api
# Сколько AI-запросов генерировать на платформу за цикл
QUERY_COUNT=3
# Сколько страниц парсить по каждому запросу
PAGES_TO_PARSE=1
# 0 = обрабатывать все vetted-кандидаты текущего цикла
TOP_PROJECTS=0

# === Session Hub (основной источник кук) ===
SESSION_HUB_URL=http://127.0.0.1:8669/cookies
# Строгий режим: если Hub недоступен — НЕ использовать .env, упасть с ошибкой.
# Рекомендуется для prod: куки в .env быстро протухают.
SESSION_HUB_REQUIRED=false

# === Kwork авторизация (fallback, если Session Hub недоступен) ===
KWORK_EMAIL=
KWORK_PASSWORD=
KWORK_JWT_TOKEN=
KWORK_COOKIE_REMEMBERME=
KWORK_COOKIE_USERID=
KWORK_COOKIE_PHPSESSID=
KWORK_COOKIE_CSRF=

# === Freelance.ru авторизация (fallback, если Session Hub недоступен) ===
FREELANCE_RU_COOKIES_JSON=
FREELANCE_RU_COOKIE_SESSION=
FREELANCE_RU_COOKIE_DUID=
FREELANCE_RU_COOKIE_REMEMBER=

# === Telegram бот ===
TELEGRAM_TOKEN=
ADMIN_CHAT_ID=
# auto = direct Bot API first, MTProto fallback if TELEGRAM_API_ID/HASH are set
TELEGRAM_TRANSPORT=auto
# Default direct route. Can point to a local telegram-bot-api server, e.g. http://127.0.0.1:8081
TELEGRAM_BOT_API_BASE=https://api.telegram.org
# Optional MTProto fallback, uses Telegram DCs instead of api.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_MTPROTO_SESSION=
APPROVAL_TIMEOUT=900
TELEGRAM_DIGEST_ENABLED=false
DIGEST_INTERVAL_MIN=60
TELEGRAM_QUEUE_PAGE_SIZE=5

# === Прокси ===
PROXY_URL=

# === Браузер ===
BROWSER_HEADLESS=true

# === Режим работы ===
CONTINUOUS_MODE=false
CYCLE_INTERVAL=1800
EXECUTION_MODE=semi_auto
AUTO_SEND_SCORE_MIN=8
AUTO_SEND_VET_MIN=60
AUTO_SEND_MAX_OFFERS=20
AUTO_SEND_MAX_BUDGET=10000

# === OSINT-обогащение заказчика ===
OSINT_ENABLED=true
# Публичные OSINT-провайдеры: github, habr, duckduckgo, kwork_profile
OSINT_PROVIDERS=github,habr,duckduckgo,kwork_profile
# GitHub token (опционально, поднимает лимит до 5000 req/h)
GITHUB_TOKEN=

# --- Пробив-площадки ---
# По умолчанию включены БЕСПЛАТНЫЕ: emailrep, whatsmyname. Они не требуют
# ключей и дают полезные сигналы (утечки email, аккаунты на других сервисах).
# Платные (hibp, leakcheck, intelx) добавляй явным списком — без ключа они
# тихо отключатся всё равно. Пусто = пробив полностью отключён.
OSINT_PROBIV_PROVIDERS=emailrep,whatsmyname
# Full scan WhatsMyName по всем 600+ сайтам (по умолчанию только ~200 популярных)
OSINT_WMN_FULL=false

# EmailRep (бесплатно; ключ увеличивает лимит)
# Регистрация: https://emailrep.io/key
EMAILREP_KEY=

# Have I Been Pwned (~$3.50/мес)
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# LeakCheck.io (от $3/мес)
# https://leakcheck.io/api
LEAKCHECK_API_KEY=

# Intelligence X (free tier + paid)
# Получить ключ: https://intelx.io/account?tab=developer
INTELX_API_KEY=
# ВАЖНО: free-tier использует ОТДЕЛЬНЫЙ хост. По умолчанию стоит free:
#   free  → https://free.intelx.io
#   paid  → https://2.intelx.io
INTELX_BASE_URL=https://free.intelx.io
# Buckets через запятую (пусто = дефолт: leaks+darknet+pastes+dumpster+whois+usenet)
INTELX_BUCKETS=
# Кол-во результатов на запрос (25 достаточно для триажа, экономит время)
INTELX_MAX_RESULTS=25

# === Shodan (для Origin IP) ===
SHODAN_API_KEY=

# === Часовой пояс ===
TIMEZONE_REGION=Europe/Warsaw
